# Launches the O3DE Project Manager from a portable install. Resolves symlinks so
# it can be linked into ~/.local/bin.

ENGINE_ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
PROJECT_MANAGER=$ENGINE_ROOT/bin/Linux/profile/Default/o3de

if [[ ! -x "$PROJECT_MANAGER" ]]; then
    echo "O3DE Project Manager not found at $PROJECT_MANAGER" >&2
    exit 1
fi

# Report missing system libraries up front instead of a bare loader error
MISSING_LIBS=$(ldd "$PROJECT_MANAGER" 2>/dev/null | awk '/not found/ {print $1}')
if [[ -n "$MISSING_LIBS" ]]; then
    echo "O3DE cannot start, these system libraries are missing:" >&2
    echo "$MISSING_LIBS" | sed 's/^/  /' >&2
    echo "See 'Required system packages' in $ENGINE_ROOT/README-linux.txt" >&2
    exit 1
fi

exec "$PROJECT_MANAGER" "$@"
